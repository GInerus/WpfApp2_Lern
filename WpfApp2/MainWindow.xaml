<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Кулькулятор" Height="350" Width="500">
    <Grid x:Name="MainRoot" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="textLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"/>

        <Button Grid.Column="0" Grid.Row="1" FontSize="40" Background="LightGray">7</Button>
        <Button Grid.Column="1" Grid.Row="1" FontSize="40" Background="LightGray">8</Button>
        <Button Grid.Column="2" Grid.Row="1" FontSize="40" Background="LightGray">9</Button>
        <Button Grid.Column="3" Grid.Row="1" FontSize="40" Background="Gray" Foreground="White">*</Button>
        <Button Grid.Column="0" Grid.Row="2" FontSize="40" Background="LightGray">4</Button>
        <Button Grid.Column="1" Grid.Row="2" FontSize="40" Background="LightGray">5</Button>
        <Button Grid.Column="1" Grid.Row="2" FontSize="40" Background="LightGray">5</Button>
        <Button Grid.Column="2" Grid.Row="2" FontSize="40" Background="LightGray">6</Button>
        <Button Grid.Column="3" Grid.Row="2" FontSize="40" Background="Gray" Foreground="White">-</Button>
        <Button Grid.Column="0" Grid.Row="3" FontSize="40" Background="LightGray" >1</Button>
        <Button Grid.Column="1" Grid.Row="3" FontSize="40" Background="LightGray">2</Button>
        <Button Grid.Column="2" Grid.Row="3" FontSize="40" Background="LightGray">3</Button>
        <Button Grid.Column="3" Grid.Row="3" FontSize="40" Background="Gray" Foreground="White">+</Button>
        <Button Grid.Column="0" Grid.Row="4" FontSize="40" Background="LightGray">0</Button>
        <Button Grid.Column="1" Grid.Row="4" FontSize="40" Background="Orange" Foreground="White">AC</Button>
        <Button Grid.Column="2" Grid.Row="4" FontSize="40" Background="Red" Foreground="White">=</Button>
        <Button Grid.Column="3" Grid.Row="4" FontSize="40" Background="Gray" Foreground="White">+</Button>

    </Grid>
</Window>
